{
  "name": "localdock",
  "private": true,
  "description": "LocalDock for Orca (work in progress): pull WordPress sites from cPanel over Orca SSH, run them with DDEV, sync changes back like Source Control.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b packages/core && node packages/orca-plugin/scripts/build.mjs",
    "preview": "tsc -b packages/core && node packages/orca-plugin/scripts/build.mjs --preview",
    "typecheck": "tsc -b packages/core && tsc -p packages/orca-plugin",
    "lint": "eslint .",
    "test": "vitest run",
    "reset-project": "tsc -b packages/core && node packages/core/scripts/reset-project.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "typescript": "~5.8",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
