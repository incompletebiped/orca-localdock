{
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "localdock",
  "name": "LocalDock",
  "version": "0.0.2",
  "description": "Work-in-progress: pull WordPress sites from cPanel servers over SSH, run them locally with DDEV, and sync changes back like Source Control.",
  "license": "MIT",
  "repository": "https://github.com/incompletebiped/orca-localdock",
  "engines": { "orca": ">=1.4.248" },
  "pluginApi": 1,
  "main": "worker.mjs",
  "contributes": {
    "panels": [{ "id": "sites", "title": "LocalDock", "icon": "database", "entry": "panel/index.html" }],
    "commands": [
      { "id": "localdock.refresh", "title": "LocalDock: Refresh", "when": "workspace" },
      { "id": "localdock.scan-changes", "title": "LocalDock: Check for changes", "when": "workspace" },
      { "id": "localdock.start", "title": "LocalDock: Start local site (DDEV)", "when": "workspace" },
      { "id": "localdock.stop", "title": "LocalDock: Stop local site (DDEV)", "when": "workspace" }
    ],
    "events": [{ "on": "workspace.changed" }],
    "statusBarItems": [{ "id": "site", "text": "LocalDock", "icon": "database", "tooltip": "LocalDock", "command": "localdock.scan-changes" }]
  },
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "notifications:show" },
    { "kind": "storage:own" }
  ]
}
